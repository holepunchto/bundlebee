{
  "name": "bundlebee",
  "version": "2.0.0",
  "description": "bundlebee",
  "main": "index.cjs",
  "imports": {
    "fs": {
      "bare": "bare-fs",
      "default": "fs"
    }
  },
  "exports": {
    "./package": "./package.json",
    ".": {
      "types": "./index.d.cts",
      "default": "./index.cjs"
    },
    "./types": {
      "types": "./dist/lib/types.d.ts",
      "default": "./dist/lib/types.js"
    }
  },
  "files": [
    "index.cjs",
    "index.d.cts",
    "dist"
  ],
  "devDependencies": {
    "@types/node": "^24.19.2",
    "bare-abort-controller": "1.1.2",
    "bare-os": "^3.9.3",
    "bare-runtime": "1.34.0",
    "brittle": "^4.5.0",
    "corestore": "^7.8.0",
    "hyperdht": "^6.29.0",
    "hyperswarm": "^4.16.0",
    "lunte": "^1.2.0",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0",
    "test-tmp": "^1.4.0",
    "typescript": "^5.9.3",
    "bare-buffer": "^3.7.1"
  },
  "scripts": {
    "format": "prettier . --write",
    "test": "npm run test:types && npm run test:node && npm run test:bare",
    "lint": "prettier . --check && lunte",
    "build": "node build.mjs",
    "test:types": "tsc -p test/types",
    "test:node": "brittle-node test/node.mjs",
    "test:bare": "brittle-bare test/all.mjs",
    "test:generate": "brittle-make-test test/all.mjs test/index.js test/records.js test/releases.js && brittle-make-test test/node.mjs test/records.js test/startup.js",
    "build:schema": "node build.js",
    "pretest": "npm run build",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holepunchto/bundlebee.git"
  },
  "author": "Holepunch Inc",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/holepunchto/bundlebee/issues"
  },
  "homepage": "https://github.com/holepunchto/bundlebee",
  "dependencies": {
    "b4a": "^1.7.4",
    "bare-bundle": "^1.10.0",
    "bare-fs": "^4.5.4",
    "bare-module": "7.1.0",
    "bare-module-traverse": "^2.7.2",
    "bare-semver": "^1.1.0",
    "compact-encoding": "^3.0.0",
    "hyperbee2": "^2.20.1",
    "hypercore-crypto": "^3.7.0",
    "hypercore-id-encoding": "^1.3.0",
    "hyperschema": "^1.20.1",
    "ready-resource": "^1.2.0",
    "url-file-url": "^1.0.5",
    "scope-lock": "^1.2.4",
    "bare-url": "^2.4.5"
  },
  "engines": {
    "bare": ">=1.34.0"
  },
  "types": "index.d.cts"
}
